// Cấu hình Cloudflare Workers.
// - "name" phải trùng Project name đặt trên Cloudflare.
// - Mật khẩu admin: Cloudflare > Worker > Settings > Variables and Secrets >
//   thêm Secret tên ADMIN_PASSWORD. Chạy local: tạo file .dev.vars (xem .dev.vars.example).
{
  "name": "lucky-draw-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./html",
    "binding": "ASSETS",
    // Mọi request đi qua Worker trước để kiểm tra đăng nhập cho trang admin
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  // Toàn bộ dữ liệu (người tham dự, giải, người trúng, cài đặt, ảnh) lưu trong
  // 1 Durable Object dùng SQLite — không cần tạo database thủ công.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "LuckyDrawStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LuckyDrawStore"] }],
  "observability": { "enabled": true }
}
